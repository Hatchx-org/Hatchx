# Supabase (Bayside-Hub)
# Copy to .env.local and fill in; never commit real values.
# Create a project at https://supabase.com, then Settings > API.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project API key > anon/public (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by Next.js instrumentation to persist uncaught Server
# Action / route errors. Never prefix this variable with NEXT_PUBLIC or expose it.
SUPABASE_SERVICE_ROLE_KEY=

# PWA push notifications. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Vercel automatically sends this secret to protected Cron routes.
CRON_SECRET=

# Transactional Club invitation delivery. Resend is tried first; Brevo is the
# automatic fallback. Verify the sender/domain with both providers.
RESEND_API_KEY=
BREVO_API_KEY=
# Optional when Brevo uses a different verified sender. Defaults to EMAIL_FROM.
BREVO_EMAIL_FROM=
EMAIL_FROM=Hatchx <clubs@example.com>

# Comma-separated domains allowed to sign in. Add the staff/advisor domain used by your school.
ALLOWED_EMAIL_DOMAINS=nycstudents.net,school.doe.gov,schools.nyc.gov

# Public production origin used for canonical metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional live Playwright role tests. Use accounts and a Supabase project made
# only for automated testing; never point mutating E2E tests at production.
# HATCHX_E2E_BASE_URL=http://127.0.0.1:3000
# HATCHX_E2E_LIVE=1
# HATCHX_E2E_STUDENT_EMAIL=
# HATCHX_E2E_STUDENT_PASSWORD=

# Auth redirect allow-list (Supabase > Auth > URL Configuration):
# - Local development: http://localhost:3000/auth/callback
# - Production:        https://your-domain.com/auth/callback
#
# Google OAuth (Supabase > Auth > Providers > Google):
# - Authorized redirect URI in Google Cloud Console must be:
#   https://<project-ref>.supabase.co/auth/v1/callback
#
# Database setup for a new Supabase project:
#   Run supabase/schema.sql once in the Supabase SQL Editor.
